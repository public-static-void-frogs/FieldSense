DATABASE_URL=postgresql+psycopg://olehzapara:@localhost:5432/fieldshiftnasa
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=fieldshift-nasa
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional upstream overrides (for local simulation or a compatible deployment):
# WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

GEMINI_API_KEY=
GEMINI_ENABLED=false
# GEMINI_MODEL=gemini-2.5-flash-lite
# Assistant system prompt (plain text, re-read when the file changes). Default: app/prompts/assistant.txt
# ASSISTANT_PROMPT_FILE=/absolute/path/to/assistant.txt
# Optional inference overrides. Defaults use repository weights and CPU (CUDA if available).
# ML_DEVICE=cpu
# SAM2_CHECKPOINT=/absolute/path/to/sam2_hiera_tiny.pt
# TEMPCNN_CHECKPOINT=/absolute/path/to/tempcnn_best.pth
# TEMPCNN_CLASSES_PATH=/absolute/path/to/classes.json
# The default mapping ships with the repository checkpoint.

# Optional. M3 defaults to the supplied model output under data/m3_out in the repository.
# M3_OUT=/absolute/path/to/m3_out
# Optional. Output folder of m2_neighbour_evidence.py (neighbour evidence on rotation and drought).
# Defaults to data/m2_out; without it the field page reports the evidence as unavailable.
# M2_OUT=/absolute/path/to/m2_out
# Optional rotation-advice inputs (season summaries, weather record, CDL history); see
# rule_engine/README.md. Without them the advice still runs and lists what is missing.
# ROTATION_DATA_ROOT=../data/local/usa_sample
# ROTATION_SOIL_LOOKUP=true
# Optional. A rotation policy trained by rule_engine/planner/scripts/train_policy.py (needs
# torch). With it the Strategy page offers the "learned" planner next to the exact one.
# The learned planner also needs PyTorch: pip install -r requirements-ml.txt
# ROTATION_POLICY_PATH=../data/local/planner/policy/policy.pt
# NASS Quick Stats key enables the county-yield component of soil depletion and the
# crop production and revenue assistant tools.
# NASS_API_KEY=
