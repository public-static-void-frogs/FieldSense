{
  "name": "nasa-fields-demo-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && node scripts/code-spacing.mjs --check",
    "preview": "vite preview",
    "test:planning": "node --experimental-strip-types --test tests/planningDates.test.mjs",
    "test:maps": "node --experimental-strip-types --test tests/mapGeometry.test.mjs",
    "test:strategy": "node --experimental-strip-types --test tests/strategy.test.mjs",
    "test:i18n": "node --experimental-strip-types --test tests/i18n.test.mjs",
    "format": "oxlint --fix && node scripts/code-spacing.mjs && prettier --write .",
    "format:check": "oxlint && node scripts/code-spacing.mjs --check && prettier --check .",
    "test:queries": "node --experimental-strip-types --test tests/queries.test.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:router": "node --experimental-strip-types --test tests/router.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "antd": "^6.6.6",
    "dayjs": "^1.11.23",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "i18next-resources-to-backend": "^1.2.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.49.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
